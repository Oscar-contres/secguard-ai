# Copia este archivo a .env y completa los valores.
# .env nunca debe subirse a un repositorio ni compartirse.

# Clave de la API de IA. Solo la usa el servidor.
API_KEY=

# Modelo que responde las consultas.
MODEL=claude-sonnet-5-5

# Dirección y puerto del servidor. Con 127.0.0.1 solo se accede desde esta máquina.
HOST=127.0.0.1
PORT=8080

# Límites de uso.
RATE_LIMIT_PER_MINUTE=10
MAX_CONCURRENT=3
MAX_MESSAGE_CHARS=12000

# Pon true solo si el servidor está detrás de un proxy o balanceador de confianza.
TRUST_PROXY=false
